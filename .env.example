# Bu dosya şablondur ve commit edilir. Gerçek anahtarlar .env içine yazılır
# ve .env ASLA commit edilmez.

# --- Veritabanı (Prisma, Supabase Postgres) — Faz 2'de kullanılacak ---
DATABASE_URL=
DIRECT_URL=

# --- Uygulama ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gemini: AI deneme görseli üretimi ---
# API key: https://aistudio.google.com/apikey
# DİKKAT: ücretsiz katmanda görsel üretimi yok; faturalandırma gerekli.
# Kullanıcı fotoğrafı bu API'ye gidiyor; veri akışı docs/BRIEF.md K3.
GEMINI_API_KEY=
# Boş bırakılırsa gemini-3.1-flash-image (Nano Banana 2).
GEMINI_GORSEL_MODELI=

# --- Deneme sınırı ---
# IP başına günlük deneme sayısı. Boş bırakılırsa 10.
GUNLUK_DENEME_LIMITI=
