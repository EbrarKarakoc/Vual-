# Bu dosya şablondur ve commit edilir. Gerçek anahtarlar .env içine yazılır
# ve .env ASLA commit edilmez.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Projenin yaşına göre anahtarın adı ANON_KEY veya PUBLISHABLE_KEY olabilir;
# lib/supabase-*.ts ikisini de kabul eder, birini doldurman yeterli.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Veritabanı (Prisma) ---
DATABASE_URL=
DIRECT_URL=

# --- Uygulama ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gemini 2.5 Flash Image: AI deneme görseli üretimi ---
# API key: https://aistudio.google.com/apikey
# DİKKAT: ücretsiz katman kullanılmayacak. Kullanıcı fotoğrafı bu API'ye
# gidiyor; veri işleme şartları docs/BRIEF.md "Mahremiyet" bölümünde.
GEMINI_API_KEY=

# --- Clarifai: yüklenen fotoğrafın içerik denetimi ---
CLARIFAI_API_KEY=
CLARIFAI_MODEL_ID=moderation
