// Hesap yok: kullanıcıya ait hiçbir tablo tutulmaz (BRIEF K1, K2).
// Katalog şu an lib/katalog.ts içinde sahte veriyle çalışıyor; bu şema Faz 2'de
// migrate edilip o verinin yerini alacak.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UrunTipi {
  sal
  esarp
}

model Marka {
  id         String   @id // "tugba" gibi okunur kimlik, URL'de kullanılır
  ad         String
  /// Türkçe ek uyumu yabancı isimlerde hesaplanamıyor: "'taki", "'ın"
  bulunmaEki String   @map("bulunma_eki")
  iyelikEki  String   @map("iyelik_eki")
  /// Ana sayfa başlığının nesnesi: "şalları", "eşarpları"
  vitrin     String
  olusturma  DateTime @default(now()) @map("olusturma")

  urunler Urun[]

  @@map("markalar")
}

model Urun {
  id          String   @id // slug
  markaId     String   @map("marka_id")
  ad          String
  /// Satıcı açıklamasından alınır, fotoğraftan tahmin edilmez
  tip         UrunTipi
  kumas       String
  olcu        String
  renk        String
  fiyat       Decimal  @db.Decimal(10, 2)
  paraBirimi  String   @default("TRY") @map("para_birimi")
  aciklama    String
  urunUrl     String   @unique @map("urun_url")
  gorseller   String[]
  /// İnsan onayından geçmeyen ürün yayına çıkmaz (BRIEF Faz 2)
  onaylandi   Boolean  @default(false)
  embedding   Unsupported("vector(384)")?
  olusturma   DateTime @default(now()) @map("olusturma")
  guncelleme  DateTime @updatedAt @map("guncelleme")

  marka Marka @relation(fields: [markaId], references: [id])

  @@index([markaId])
  @@map("urunler")
}
